---
// Stage 1: a canvas-style design view. The canvas itself is the shared Preview; this adds the layers
// panel (left), the properties panel (right) and a floating tool bar. Three siblings, no wrapper box.
const layers: { name: string; depth: number; glyph: string; on?: boolean }[] = [
  { name: "NotificationCard", depth: 0, glyph: "frame", on: true },
  { name: "Avatar", depth: 1, glyph: "circle" },
  { name: "Title", depth: 1, glyph: "text" },
  { name: "Subtitle", depth: 1, glyph: "text" },
  { name: "Button", depth: 1, glyph: "button" },
];
const tokens: [string, string][] = [["card", "var(--pv-bg)"], ["card-foreground", "var(--pv-fg)"], ["muted-foreground", "var(--pv-muted)"], ["primary", "var(--primary)"]];
---
<aside class="stage s1 layers">
  <p class="head mono">Layers</p>
  <ul>
    {layers.map((l) => (
      <li class:list={["row", { on: l.on }]} style={`--depth:${l.depth}`}>
        <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.2">
          {l.glyph === "frame" && <path d="M3.5 1v10M8.5 1v10M1 3.5h10M1 8.5h10" />}
          {l.glyph === "circle" && <circle cx="6" cy="6" r="4.2" />}
          {l.glyph === "text" && <path d="M2 3h8M6 3v7" />}
          {l.glyph === "button" && <rect x="1" y="3" width="10" height="6" rx="2" />}
        </svg>
        <span>{l.name}</span>
      </li>
    ))}
  </ul>
</aside>

<aside class="stage s1 props">
  <div class="seg mono"><span class="on">Design</span><span>Code</span></div>
  <p class="sel-name">NotificationCard</p>
  <dl class="grid">
    <div><dt>W</dt><dd>384</dd></div>
    <div><dt>H</dt><dd>72</dd></div>
    <div class="live-val"><dt>Radius</dt><dd data-radius-val>24</dd></div>
    <div><dt>Padding</dt><dd>16</dd></div>
    <div><dt>Gap</dt><dd>16</dd></div>
  </dl>
  <p class="head mono">Color tokens</p>
  <ul class="tokens">
    {tokens.map(([name, color]) => <li><span class="sw" style={`--c:${color}`}></span><span class="mono">{name}</span></li>)}
  </ul>
  <p class="head mono snippet-head">Code</p>
  <p class="snippet mono">rounded-3xl p-4 gap-4</p>
</aside>

<div class="stage s1 tools">
  <span class="tool on"><svg viewBox="0 0 14 14" width="14" height="14" fill="currentColor"><path d="M3 1.5 11.500 7 7.400 8 5.800 12z" /></svg></span>
  <span class="tool"><svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4.500 1.500v11M9.500 1.500v11M1.500 4.500h11M1.500 9.500h11" /></svg></span>
  <span class="tool"><svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="2" y="2" width="10" height="10" rx="2" /></svg></span>
  <span class="tool"><svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M2.500 3.500h9M7 3.500v8" /></svg></span>
  <span class="tool"><svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M2 3a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H6.500L3.500 12.500V10H3a1 1 0 0 1-1-1z" /></svg></span>
</div>

<style>
  .layers, .props { grid-row: 1; min-width: 0; overflow: hidden; padding: 12px 8px; font-size: 12.5px; color: var(--muted-foreground); }
  .layers { grid-column: 1; border-right: 1px solid var(--border); }
  .props { grid-column: 3; border-left: 1px solid var(--border); padding: 12px; font-size: 12px; }
  .head { font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; padding: 0 8px 8px; opacity: .8; }
  .props .head { padding: 16px 0 8px; }
  .row { display: flex; align-items: center; gap: 8px; padding: 5px 8px 5px calc(8px + var(--depth) * 16px); border-radius: 6px; white-space: nowrap; }
  .row svg { flex: none; opacity: .75; }
  .row span { overflow: hidden; text-overflow: ellipsis; }
  .row.on { background: color-mix(in srgb, var(--secondary) 16%, transparent); color: var(--secondary-ink); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--secondary) 35%, transparent); }
  .seg { display: flex; gap: 2px; padding: 2px; border-radius: 8px; background: var(--muted); font-size: 11px; margin-bottom: 12px; }
  .seg span { flex: 1; text-align: center; padding: 3px 0; border-radius: 6px; }
  .seg .on { background: var(--background); color: var(--foreground); box-shadow: 0 1px 2px color-mix(in srgb, black 12%, transparent); }
  .sel-name { color: var(--foreground); font-weight: 500; font-size: 13px; margin-bottom: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .grid div { display: flex; justify-content: space-between; align-items: center; gap: 6px; border: 1px solid var(--border); border-radius: 6px; padding: 4px 8px; min-width: 0; }
  dt { font-size: 11px; } dd { font: 500 12px var(--font-mono); color: var(--foreground); }
  .tokens { display: grid; gap: 7px; }
  .tokens li { display: flex; align-items: center; gap: 9px; min-width: 0; font-size: 11px; color: var(--foreground); }
  .tokens .mono { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sw { width: 18px; height: 18px; flex: none; border-radius: 5px; background: var(--c); box-shadow: inset 0 0 0 1px var(--border); transition: background-color .5s; }
  .snippet { font-size: 11px; color: var(--foreground); background: var(--muted); border-radius: 6px; padding: 5px 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* floating tools, bottom centre of the canvas */
  .tools { position: absolute; z-index: 4; bottom: 14px; left: 0; right: 0; margin-inline: auto; width: max-content; display: flex; gap: 2px; padding: 4px; border: 1px solid var(--border); border-radius: 12px; background: var(--popover); box-shadow: 0 10px 24px -14px color-mix(in srgb, black 50%, transparent); color: var(--muted-foreground); }
  .tool { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 8px; }
  .tool.on { background: var(--secondary); color: var(--secondary-foreground); }
  @media (prefers-reduced-motion: no-preference) {
    :global([data-live="true"][data-stage="1"]) .live-val dd { animation: flash .5s 0.9s; }
    :global([data-live="true"][data-stage="1"]) .layers .row { animation: slide-in .5s var(--ease) backwards; }
    :global([data-live="true"][data-stage="1"]) .layers .row:nth-child(2) { animation-delay: .1s; }
    :global([data-live="true"][data-stage="1"]) .layers .row:nth-child(3) { animation-delay: .2s; }
    :global([data-live="true"][data-stage="1"]) .layers .row:nth-child(4) { animation-delay: .3s; }
    :global([data-live="true"][data-stage="1"]) .layers .row:nth-child(5) { animation-delay: .4s; }
  }
  @keyframes flash { 40% { color: var(--secondary-ink); } }
  @keyframes slide-in { from { opacity: 0; translate: -6px 0; } }
  /* tablet: narrow properties column, keep it to the essentials */
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .snippet-head, .snippet { display: none; } }
  /* phone: no side panels; the properties collapse into a compact row under the canvas */
  @media (max-width: 700px) {
    .layers, .tools, .seg { display: none; }
    .props .head { padding-top: 12px; }
    .tokens { grid-template-columns: 1fr 1fr; }
    .props { grid-column: 1; grid-row: 2; border-left: 0; padding: 12px 14px; }
    .sel-name { margin-bottom: 8px; }
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
