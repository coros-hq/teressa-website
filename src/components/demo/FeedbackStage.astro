---
// Stage 3: the published component page as a live community thread. People comment, one replies,
// someone is typing. The card (left) is the shared Preview with live cursors and a comment on it.
// Invented names only; no counts or ratings.
---
<div class="stage s3 feed">
  <div class="fhead">
    <span class="ft">notification-card</span>
    <span class="presence">
      <span class="avs"><b style="--who:var(--who-a)">A</b><b style="--who:var(--who-b)">S</b><b style="--who:var(--who-c)">M</b></span>
      <span class="live mono"><i></i>Live</span>
    </span>
  </div>
  <ul class="thread">
    <li class="c1">
      <span class="av" style="--who:var(--who-b)">S</span>
      <div class="bub">
        <div class="meta"><span class="nm">Sol</span><span class="when mono">just now</span><span class="badge tag">Accessibility</span></div>
        <p>Add an aria-label here. Screen readers won't announce the icon-only state.</p>
        <span class="addr"><span class="a-todo">Mark as addressed</span><span class="a-done">✓ Addressed</span></span>
      </div>
    </li>
    <li class="c2">
      <span class="av" style="--who:var(--who-c)">M</span>
      <div class="bub small">
        <div class="meta"><span class="nm">Mina</span><span class="when mono">author</span></div>
        <p>Good catch. I'll ship a fix in the next version.</p>
      </div>
    </li>
  </ul>
  <div class="typing"><span class="av sm" style="--who:var(--who-a)">A</span><span class="mono">Ari is typing</span><span class="d3"><i></i><i></i><i></i></span></div>
  <div class="composer">Add a comment…</div>
</div>

<style>
  .s3 { grid-row: 1; grid-column: 2; min-width: 0; border-left: 1px solid var(--border); padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; }
  .fhead { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .ft { font-weight: 500; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .presence { margin-left: auto; display: flex; align-items: center; gap: 8px; flex: none; }
  .avs { display: flex; }
  .avs b { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font: 600 10px var(--font-sans); color: white; background: var(--who); box-shadow: 0 0 0 2px var(--card); }
  .avs b + b { margin-left: -6px; }
  .live { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--muted-foreground); }
  .live i { width: 6px; height: 6px; border-radius: 50%; background: var(--primary); }
  .thread { display: grid; gap: 10px; }
  .thread li { display: flex; gap: 10px; align-items: flex-start; min-width: 0; }
  .av { width: 24px; height: 24px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--who); color: white; font: 600 11px var(--font-sans); }
  .av.sm { width: 18px; height: 18px; font-size: 9px; }
  .bub { min-width: 0; flex: 1; display: grid; gap: 7px; background: var(--background); border: 1px solid var(--border); border-radius: 4px 12px 12px 12px; padding: 10px 12px; }
  .bub.small { gap: 4px; padding: 8px 12px; }
  .meta { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .nm { font-size: 12.5px; font-weight: 600; }
  .when { font-size: 10.5px; color: var(--muted-foreground); }
  .tag { margin-left: auto; color: var(--primary-ink); border-color: color-mix(in srgb, var(--primary) 45%, transparent); }
  .bub p { font-size: 12.5px; line-height: 1.45; color: var(--foreground); }
  .addr { justify-self: start; display: inline-grid; font: 500 12px var(--font-sans); border: 1px solid var(--input); border-radius: 99px; padding: 3px 12px; color: var(--foreground); }
  .addr > span { grid-area: 1 / 1; text-align: center; }
  .a-done { opacity: 0; }
  .typing { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--muted-foreground); }
  .d3 { display: inline-flex; gap: 3px; }
  .d3 i { width: 4px; height: 4px; border-radius: 50%; background: currentColor; }
  .composer { margin-top: auto; border: 1px solid var(--input); border-radius: 99px; padding: 7px 14px; font-size: 12.5px; color: var(--muted-foreground); background: var(--background); }
  @media (prefers-reduced-motion: no-preference) {
    :global([data-live="true"][data-stage="3"]) .live i { animation: pulse 2.4s ease-out infinite; }
    :global([data-live="true"][data-stage="3"]) .c1 { animation: slide-up .6s var(--ease) .35s backwards; }
    :global([data-live="true"][data-stage="3"]) .addr { animation: addr-on .3s 3s forwards; }
    :global([data-live="true"][data-stage="3"]) .a-todo { animation: swap-out .01s 3.05s forwards; }
    :global([data-live="true"][data-stage="3"]) .a-done { animation: swap-in .2s 3.05s forwards; }
    :global([data-live="true"][data-stage="3"]) .c2 { animation: slide-up .6s var(--ease) 3.6s backwards; }
    :global([data-live="true"][data-stage="3"]) .typing { animation: slide-up .5s var(--ease) 4.6s backwards; }
    :global([data-live="true"][data-stage="3"]) .d3 i { animation: bounce 1.1s ease-in-out infinite; }
    :global([data-live="true"][data-stage="3"]) .d3 i:nth-child(2) { animation-delay: .15s; }
    :global([data-live="true"][data-stage="3"]) .d3 i:nth-child(3) { animation-delay: .3s; }
  }
  @keyframes slide-up { from { opacity: 0; translate: 0 14px; } }
  @keyframes addr-on { to { background: var(--secondary); color: var(--secondary-foreground); border-color: var(--secondary); } }
  @keyframes swap-out { to { opacity: 0; } }
  @keyframes swap-in { to { opacity: 1; } }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--primary) 55%, transparent); } 70%, 100% { box-shadow: 0 0 0 6px transparent; } }
  @keyframes bounce { 40% { translate: 0 -3px; } 80% { translate: 0 0; } }
  @media (max-width: 700px) {
    .s3 { grid-column: 1; grid-row: 2; border-left: 0; padding: 14px; min-height: 330px; }
    .composer { display: none; }
    .live { display: none; }
    .fhead { display: none; }
  }
</style>
