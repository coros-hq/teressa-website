---
// Stage 2: checklist ticks off, Publish is pressed, then a page link and an install command appear.
// All placeholder text; nothing here is a real address or package.
const checks = ["TypeScript compiles", "Accessibility check passes", "Theme tokens, not hardcoded colors", "Works in light and dark mode"];
---
<div class="stage s2">
  <p class="head mono">Before you publish</p>
  <ul class="checks">
    {checks.map((c, i) => (
      <li style={`--i:${i}`}>
        <span class="tick"><svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.4l2.1 2.1L9 4.4" /></svg></span>
        <span class="ct">{c}</span>
      </li>
    ))}
  </ul>
  <span class="pub"><span class="l-todo">Publish</span><span class="l-done">✓ Published</span></span>
  <div class="out">
    <div class="line"><span class="cap mono">Page</span>
      <span class="chip mono"><svg viewBox="0 0 14 14" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M6 8a2.5 2.5 0 0 0 3.500 0l2-2a2.500 2.500 0 0 0-3.500-3.500L7.200 3.300M8 6a2.500 2.500 0 0 0-3.500 0l-2 2a2.500 2.500 0 0 0 3.500 3.500l.8-.8" /></svg><span class="tt">teressa.example/c/notification-card</span></span></div>
    <div class="line"><span class="cap mono">Install</span>
      <span class="chip mono"><span class="tt">teressa add notification-card</span><span class="cp">Copy</span></span></div>
  </div>
</div>

<style>
  .s2 { grid-row: 1; grid-column: 1; padding: 16px 18px; min-width: 0; border-right: 1px solid var(--border); display: flex; flex-direction: column; gap: 14px; }
  .head { font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted-foreground); }
  .checks { display: grid; gap: 9px; }
  .checks li { display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .tick { width: 20px; height: 20px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--secondary); color: var(--secondary-foreground); }
  .pub { align-self: flex-start; display: inline-grid; background: var(--primary); color: var(--primary-foreground); font: 600 14px var(--font-sans); padding: 9px 22px; border-radius: 99px; }
  .pub > span { grid-area: 1 / 1; text-align: center; }
  .l-done { opacity: 0; }
  .out { display: grid; gap: 10px; }
  .line { display: grid; gap: 4px; min-width: 0; }
  .cap { font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted-foreground); }
  .chip { display: flex; align-items: center; gap: 8px; min-width: 0; border: 1px solid var(--input); border-radius: 8px; background: var(--background); padding: 6px 10px; font-size: 12px; }
  .chip svg { flex: none; color: var(--secondary-ink); }
  .tt { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cp { margin-left: auto; flex: none; border: 1px solid var(--border); border-radius: 5px; padding: 1px 8px; font-size: 11px; color: var(--muted-foreground); background: var(--card); }
  @media (prefers-reduced-motion: no-preference) {
    :global([data-live="true"][data-stage="2"]) .checks li { --at: calc(.35s + var(--i) * .5s); }
    :global([data-live="true"][data-stage="2"]) .tick { animation: tick-bg .3s var(--at) backwards; }
    :global([data-live="true"][data-stage="2"]) .tick svg path { stroke-dasharray: 12; animation: tick-draw .3s calc(var(--at) + .08s) backwards; }
    :global([data-live="true"][data-stage="2"]) .ct { animation: label-in .3s var(--at) backwards; }
    :global([data-live="true"][data-stage="2"]) .pub { animation: enable .3s 1.9s backwards, press .35s 2.55s; }
    :global([data-live="true"][data-stage="2"]) .l-todo { animation: swap-out .01s 2.75s forwards; }
    :global([data-live="true"][data-stage="2"]) .l-done { animation: swap-in .2s 2.75s forwards; }
    :global([data-live="true"][data-stage="2"]) .out { animation: rise .55s var(--ease) 3.1s backwards; }
  }
  @keyframes tick-bg { from { background: transparent; box-shadow: inset 0 0 0 1px var(--input); } }
  @keyframes tick-draw { from { stroke-dashoffset: 12; } }
  @keyframes label-in { from { color: var(--muted-foreground); } }
  @keyframes enable { from { opacity: .4; } }
  @keyframes press { 45% { scale: .94; } }
  @keyframes swap-out { to { opacity: 0; } }
  @keyframes swap-in { to { opacity: 1; } }
  @keyframes rise { from { opacity: 0; translate: 0 10px; } }
  @media (max-width: 700px) { .s2 { grid-row: 2; border-right: 0; padding: 14px; gap: 12px; } .checks li { font-size: 13px; } .chip { font-size: 11px; } }
</style>
