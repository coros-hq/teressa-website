---
import Button from "./Button.astro";
import EditorMock from "./EditorMock.astro";
import { copy } from "../data/copy";
const h = copy.hero;
---
<header id="hero">
  <canvas class="pixel-trail" id="pixel-trail" aria-hidden="true"></canvas>
  <div class="bars" aria-hidden="true">{Array.from({ length: 12 }).map(() => <i />)}</div>
  <div class="wrap copy">
    <p class="eyebrow" data-fade>{h.kicker}</p>
    <h1 data-split>{h.title}</h1>
    <p class="lead" data-fade style="--d:.5s">{h.sub}</p>
    <div class="row" data-fade style="--d:.65s">
      <Button href="#waitlist">{h.primary}</Button>
      <a class="text-link" href="#how">{h.secondary}</a>
    </div>
  </div>
  <div class="wrap visual" data-fade style="--d:.8s"><EditorMock /></div>
</header>

<style>
  #hero { position: relative; overflow: hidden; padding: 72px 0 100px; }
  .pixel-trail { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .bars { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(12, 1fr); max-width: 1240px; margin: 0 auto; padding: 0 24px; pointer-events: none; }
  .bars i { border-left: 1px solid var(--border); } .bars i:last-child { border-right: 1px solid var(--border); }
  h1 { font-size: clamp(44px, 7.6vw, 112px); line-height: .96; letter-spacing: -.045em; font-weight: 400; max-width: 11em; margin: 20px 0 28px; }
  .lead { margin-bottom: 34px; }
  .row { display: flex; gap: 28px; align-items: center; flex-wrap: wrap; }
  .visual { margin-top: 84px; }
  @media (max-width: 860px) { .bars { grid-template-columns: repeat(4, 1fr); } .bars i:nth-child(n+5) { display: none; } .visual { margin-top: 56px; } }
</style>
