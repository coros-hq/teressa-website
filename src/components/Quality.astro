---
import { copy } from "../data/copy";
const m = copy.quality;
---
<section id="quality" class="section alt">
  <div class="wrap">
    <p class="eyebrow" data-fade>{m.eyebrow}</p>
    <h2 class="title" data-split>{m.title}</h2>
    <p class="lead big" data-fade>{m.lead}</p>
    <ol class="pillars">
      {m.pillars.map((p, i) => (
        <li data-fade style={`--d:${i * 0.12}s`}>
          <span class="mono n">0{i + 1}</span>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .big { font-size: clamp(20px, 2.4vw, 30px); color: var(--foreground); max-width: 28em; letter-spacing: -.01em; }
  .pillars { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 64px 0 0; }
  .pillars li { background: var(--background); border: 1px solid var(--border); border-radius: 18px; padding: 28px; }
  .n { font-size: 12px; color: var(--primary-ink); }
  h3 { font-size: 26px; font-weight: 400; letter-spacing: -.02em; margin: 10px 0 10px; }
  .pillars p { color: var(--muted-foreground); font-weight: 300; }
  @media (max-width: 860px) { .pillars { grid-template-columns: 1fr; } }
</style>
