---
import { copy } from "../data/copy";
const chat = copy.features.pair.chat;
const lines = [
  `    &lt;<span class="k">Button</span> <span class="c">size</span>=<span class="s">"sm"</span>`,
  `      <span class="c">className</span>=<span class="s">"focus-visible:ring-</span><span class="sel a">ring</span><span class="s">"</span><span class="caret a"><em>Ana</em></span>`,
  `      <span class="c">variant</span>=<span class="s">"</span><span class="sel s">default</span><span class="s">"</span><span class="caret s"><em>Sam</em></span>`,
  `    &gt;Mark addressed&lt;/<span class="k">Button</span>&gt;`,
];
---
<div class="window pair" data-assemble data-gap="1100" aria-label="Illustration of a live pair session with two cursors, a shared preview and a chat panel">
  <div class="window-bar">
    <span class="dots"><i></i><i></i><i></i></span>
    <span>notification-card.tsx · pair session</span>
    <span class="who"><span class="av a">A</span><span class="av s">S</span></span>
  </div>
  <div class="cols">
    <pre class="code" aria-hidden="true">{lines.map((l, i) => <span class="cl"><span class="ln">{12 + i}</span><Fragment set:html={l} /></span>)}</pre>
    <div class="prev">
      <span class="mono cap">Shared preview</span>
      <div class="pv"><span class="pv-btn">Mark addressed</span></div>
    </div>
    <div class="chat">
      <span class="mono cap">Chat</span>
      {chat.map((m, i) => (
        <p class={`msg ${m.who === "Ana" ? "a" : "s"}`} data-step={i + 1}><b>{m.who}</b>{m.msg}</p>
      ))}
    </div>
  </div>
</div>

<style>
  .cols { display: grid; grid-template-columns: 1.5fr 1fr 1fr; min-height: 300px; }
  .code { padding: 18px 10px 18px 14px; border-right: 1px solid var(--border); font-size: 12.5px; }
  :global(.cl) { display: block; position: relative; }
  :global(.sel) { border-radius: 3px; padding: 0 2px; } :global(.sel.a) { background: color-mix(in srgb, var(--primary) 30%, transparent); } :global(.sel.s) { background: color-mix(in srgb, var(--secondary) 35%, transparent); }
  :global(.caret) { display: inline-block; width: 2px; height: 1.2em; vertical-align: text-bottom; margin-left: 1px; position: relative; animation: blink 1.1s steps(2) infinite; }
  :global(.caret.a) { background: var(--primary); } :global(.caret.s) { background: var(--secondary); animation-delay: .4s; }
  :global(.caret em) { position: absolute; bottom: 100%; left: 0; font: 500 10px var(--font-mono); font-style: normal; color: #fff; padding: 1px 6px; border-radius: 4px 4px 4px 0; }
  :global(.caret.a em) { background: var(--primary); } :global(.caret.s em) { background: var(--secondary); }
  @keyframes blink { 50% { opacity: .25; } }
  .prev, .chat { padding: 14px; display: flex; flex-direction: column; gap: 10px; }
  .prev { border-right: 1px solid var(--border); background: var(--background); }
  .cap { font-size: 11px; color: var(--muted-foreground); text-transform: uppercase; letter-spacing: .1em; }
  .pv { flex: 1; display: grid; place-items: center; }
  .pv-btn { background: var(--primary); color: #fff; font-size: 13px; font-weight: 500; padding: 8px 16px; border-radius: 99px; outline: 2px solid var(--ring); outline-offset: 3px; }
  .msg { font-size: 13px; line-height: 1.4; border-radius: 12px; padding: 8px 12px; background: var(--muted); }
  .msg b { display: block; font: 500 10px var(--font-mono); margin-bottom: 2px; }
  .msg.a b { color: var(--primary-ink); } .msg.s b { color: var(--secondary-ink); }
  .who { margin-left: auto; display: flex; } .av { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font: 500 10px var(--font-mono); color: #fff; border: 2px solid var(--card); }
  .av.a { background: var(--primary); } .av.s { background: var(--secondary); margin-left: -6px; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } .code, .prev { border-right: 0; border-bottom: 1px solid var(--border); } .prev { min-height: 120px; } }
</style>
