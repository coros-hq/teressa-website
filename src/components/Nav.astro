---
import Button from "./Button.astro";
import { copy } from "../data/copy";
---
<nav class="nav" id="nav" aria-label="Main">
  <div class="nav-links">
    {copy.nav.links.map((l) => <a class="hover-link" href={l.href}><span data-t={l.label}>{l.label}</span></a>)}
  </div>
  <a class="logo" href="/" aria-label={`${copy.brand} home`}><img class="logo-mark logo-dark" src="/logo-dark.svg" alt="" width="34" height="32" /><img class="logo-mark logo-light" src="/logo-light.svg" alt="" width="34" height="32" />{copy.brand.toLowerCase()}</a>
  <div class="nav-right">
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme">
      <svg class="ico i-moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="ico i-sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <span id="theme-label">Theme</span>
    </button>
    <Button href="#waitlist" variant="ghost">{copy.nav.cta}</Button>
  </div>
</nav>

<style>
  .nav { position: sticky; top: 0; z-index: 20; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 16px 24px; border-bottom: 1px solid transparent; transition: background .3s, border-color .3s; }
  .nav.scrolled { background: color-mix(in srgb, var(--background) 82%, transparent); backdrop-filter: blur(14px); border-color: var(--border); }
  .nav-links { display: flex; gap: 28px; font-size: 15px; }
  .nav-right { display: flex; justify-content: flex-end; align-items: center; gap: 20px; }
  .logo { display: inline-flex; align-items: center; gap: 8px; font-size: 24px; font-weight: 500; letter-spacing: -.03em; text-decoration: none; }
  .logo-mark { width: 34px; height: auto; transition: rotate .6s var(--ease); }
  .logo:hover .logo-mark { rotate: -8deg; }
  .logo-dark { display: none; }
  .theme-toggle { display: inline-flex; align-items: center; gap: 8px; background: none; border: 1px solid var(--border); color: inherit; border-radius: 99px; padding: 6px 12px; font: 400 12px var(--font-mono); cursor: pointer; }
  .theme-toggle .ico { color: var(--primary-ink); flex: none; transition: rotate .5s var(--ease); }
  .theme-toggle:hover .ico { rotate: 25deg; }
  .hover-link { text-decoration: none; display: inline-block; overflow: hidden; height: 1.55em; line-height: 1.55; }
  .hover-link span { display: block; position: relative; transition: transform .5s var(--ease); }
  .hover-link span::after { content: attr(data-t); position: absolute; left: 0; top: 100%; color: var(--primary-ink); }
  .hover-link:hover span, .hover-link:focus-visible span { transform: translateY(-100%); }
  @media (max-width: 860px) { .nav { grid-template-columns: auto 1fr; } .nav-links, .theme-toggle { display: none; } }
</style>
