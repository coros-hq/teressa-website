---
// The hero visual: a component that assembles itself. Code lines and preview pieces share step numbers.
const lines: [number, string][] = [
  [1, `<span class="k">import</span> { Card } <span class="k">from</span> <span class="s">"@/components/ui/card"</span>`],
  [1, `<span class="k">import</span> { Button } <span class="k">from</span> <span class="s">"@/components/ui/button"</span>`],
  [1, ``],
  [1, `<span class="k">export function</span> NotificationCard() {`],
  [1, `  <span class="k">return</span> (`],
  [2, `    &lt;Card <span class="c">className</span>=<span class="s">"flex items-center gap-4 rounded-3xl p-4"</span>&gt;`],
  [3, `      &lt;Avatar <span class="c">className</span>=<span class="s">"size-11 bg-muted"</span> /&gt;`],
  [4, `      &lt;h4 <span class="c">className</span>=<span class="s">"font-semibold"</span>&gt;New Comment&lt;/h4&gt;`],
  [5, `      &lt;p <span class="c">className</span>=<span class="s">"text-muted-foreground"</span>&gt;From DesignGuru22&lt;/p&gt;`],
  [6, `      &lt;Button <span class="c">className</span>=<span class="s">"ml-auto"</span>&gt;Mark As Read&lt;/Button&gt;`],
  [6, `    &lt;/Card&gt;`],
  [6, `  )`],
  [6, `}`],
];
---
<figure class="mock" data-assemble data-gap="750" aria-label="Illustration: a component being written on the left and rendering on the right">
  <div class="window">
    <div class="window-bar">
      <span class="dots"><i></i><i></i><i></i></span>
      <span>notification-card.tsx</span>
      <span class="badge s" style="margin-left:auto">● Autosaved</span>
    </div>
    <div class="body">
      <pre class="code" aria-hidden="true">{lines.map(([s, l], i) => <span class="cl" data-step={s}><span class="ln">{i + 1}</span><Fragment set:html={l || "&nbsp;"} /></span>)}</pre>
      <div class="preview">
        <div class="preview-bar"><span class="mono">Preview</span><span class="pill-row"><span class="pill on">Light</span><span class="pill">Dark</span></span></div>
        <div class="stage">
          <div class="pv-card" data-step="2">
            <img class="pv-avatar" data-step="3" src="/avatar.png" alt="" width="50" height="50" />
            <div class="pv-text">
              <p class="pv-title" data-step="4">New Comment</p>
              <p class="pv-desc" data-step="5">From DesignGuru22</p>
            </div>
            <span class="pv-btn" data-step="6">Mark As Read</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="mono">A mock-up of the editor. Teressa hasn't launched yet.</figcaption>
</figure>

<style>
  .mock { max-width: 1080px; margin: 0 auto; }
  .body { display: grid; grid-template-columns: 1.2fr 1fr; }
  .code { padding: 18px 8px 18px 14px; border-right: 1px solid var(--border); min-height: 360px; }
  :global(.cl) { display: block; }
  .preview { display: flex; flex-direction: column; background: var(--background); }
  .preview-bar { display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; font-size: 12px; color: var(--muted-foreground); border-bottom: 1px solid var(--border); }
  .stage { flex: 1; display: grid; place-items: center; padding: 24px 16px; background-image: radial-gradient(var(--border) 1px, transparent 1px); background-size: 16px 16px; }
  .pv-card { width: 100%; max-width: 420px; border: 1px solid #ffffff14; border-radius: 30px; background: #141414; color: #f4f4f1; padding: 18px 18px 18px 20px; display: flex; align-items: center; gap: 14px; box-shadow: 0 18px 40px -18px #000a; }
  .pv-avatar { width: 50px; height: 50px; border-radius: 50%; background: #f4f4f1; object-fit: cover; flex: none; }
  .pv-text { display: grid; gap: 1px; min-width: 0; }
  .pv-title { font-weight: 600; font-size: 19px; line-height: 1.2; letter-spacing: -.01em; white-space: nowrap; }
  .pv-desc { font-size: 13.5px; color: #a3a3a1; white-space: nowrap; }
  .pv-btn { margin-left: auto; flex: none; background: var(--primary); color: #fff; font-size: 14px; font-weight: 600; padding: 10px 20px; border-radius: 7px; white-space: nowrap; }
  figcaption { text-align: center; font-size: 12px; color: var(--muted-foreground); margin-top: 14px; }
  @media (max-width: 860px) { .body { grid-template-columns: 1fr; } .code { border-right: 0; border-bottom: 1px solid var(--border); min-height: 0; font-size: 11px; } .stage { padding: 20px 12px; } .pv-card { max-width: 100%; } }
</style>
